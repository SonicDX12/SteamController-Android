<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Paragraph 1 -->
        <TextView
            style="@style/HelpParagraph"
            android:text="@string/help_para_puck_slots" />

        <!-- Paragraph 2 -->
        <TextView
            style="@style/HelpParagraph"
            android:text="@string/help_para_bt_independent" />

        <!-- Paragraph 3 -->
        <TextView
            style="@style/HelpParagraph"
            android:text="@string/help_para_power_off" />

        <!-- Section: wireless modes -->
        <TextView
            style="@style/HelpSectionLabel"
            android:text="@string/help_section_wireless" />

        <TextView
            style="@style/HelpParagraph"
            android:text="@string/help_para_wireless_intro" />

        <include layout="@layout/include_help_bullet" android:id="@+id/bulletPuckRight" />
        <include layout="@layout/include_help_bullet" android:id="@+id/bulletPuckLeft" />
        <include layout="@layout/include_help_bullet" android:id="@+id/bulletBluetooth" />

        <!-- Section: wired -->
        <TextView
            style="@style/HelpSectionLabel"
            android:text="@string/help_section_wired" />

        <include layout="@layout/include_help_bullet" android:id="@+id/bulletWiredOff" />
        <include layout="@layout/include_help_bullet" android:id="@+id/bulletWiredOn" />

    </LinearLayout>
</ScrollView>
